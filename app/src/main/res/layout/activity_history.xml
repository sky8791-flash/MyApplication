<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_pink"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📜 对战历史"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/sparkle_purple"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 筛选按钮 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="🎮 全部"
                android:textSize="14sp"
                android:backgroundTint="@color/sparkle_purple"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnGomoku"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="💕 五子棋"
                android:textSize="14sp"
                android:backgroundTint="@color/sparkle_pink"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnGo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="🌟 围棋"
                android:textSize="14sp"
                android:backgroundTint="@color/sparkle_blue"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnXiangqi"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="✨ 象棋"
                android:textSize="14sp"
                android:backgroundTint="@color/star_yellow"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="🗑️ 清空"
                android:textSize="14sp"
                android:backgroundTint="#FF5252" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 统计信息卡片 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp"
            android:text="正在加载统计信息..." />

    </androidx.cardview.widget.CardView>

    <!-- 历史记录列表 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏱️ 历史对局"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/sparkle_purple"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/historyListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

</LinearLayout>
