<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Top Bar with Super Kawaii Anime Style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:elevation="12dp">
        
        <Button
            android:id="@+id/btnBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="💝"
            android:textSize="28sp"
            android:textColor="@color/white"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        
        <TextView
            android:id="@+id/tvGameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎯✨ 五子棋"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:shadowColor="@color/sparkle_purple"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"/>
        
        <View
            android:layout_width="52dp"
            android:layout_height="52dp"/>
    </LinearLayout>

    <!-- Bluetooth Control Buttons with Pastel Colors -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:gravity="center_vertical">
        
        <Button
            android:id="@+id/btnDiscover"
            style="@style/PrimaryButton"
            android:text="@string/scan_devices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
        
        <Button
            android:id="@+id/btnHost"
            style="@style/SecondaryButton"
            android:text="@string/wait_connection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
        
        <Button
            android:id="@+id/btnAI"
            style="@style/SecondaryButton"
            android:text="🤖💫 AI对战"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textSize="11sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
    </LinearLayout>
    
    <!-- LAN Control Buttons -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical">
        
        <Button
            android:id="@+id/btnLanDiscover"
            style="@style/PrimaryButton"
            android:text="🌐 局域网扫描"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="10sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
        
        <Button
            android:id="@+id/btnLanHost"
            style="@style/SecondaryButton"
            android:text="📡 创建房间"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textSize="10sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>
    </LinearLayout>

    <!-- Devices List (Super Kawaii Card Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDevices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FFF5FA"
        app:strokeColor="@color/sparkle_pink"
        app:strokeWidth="3dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨💕 附近设备"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:padding="14dp"
                android:shadowColor="@color/sparkle_pink"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>
            
            <ListView
                android:id="@+id/listDevices"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:divider="@color/primary_light"
                android:dividerHeight="1dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Game Board (Super Kawaii Rounded Style) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">
        
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/board_background"
            app:strokeColor="@color/sparkle_purple"
            app:strokeWidth="4dp">
            
            <com.example.myapplication.BoardView
                android:id="@+id/boardView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="8dp"/>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Game Control Buttons (Cute Style) -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:gravity="center">
        
        <Button
            android:id="@+id/btnUndo"
            style="@style/WarningButton"
            android:text="@string/undo_move"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
