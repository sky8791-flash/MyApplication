<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:colorBackground">@color/background_light</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />
    
    <!-- Custom button styles -->
    <style name="RoundedButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    
    <style name="PrimaryButton" parent="RoundedButton">
        <item name="backgroundTint">@color/button_primary</item>
    </style>
    
    <style name="SecondaryButton" parent="RoundedButton">
        <item name="backgroundTint">@color/button_secondary</item>
    </style>
    
    <style name="WarningButton" parent="RoundedButton">
        <item name="backgroundTint">@color/button_warning</item>
    </style>
</resources>